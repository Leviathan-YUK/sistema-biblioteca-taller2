<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="com.biblioteca.controlador.MainController"
         tabClosingPolicy="UNAVAILABLE">

    <Tab text="Libros">
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Registrar nuevo libro" style="-fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="8">
                <Label text="Codigo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="codigoField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Titulo:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="tituloField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Autor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="autorField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Categoria:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="categoriaCombo" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Editorial:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="editorialField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="ISBN:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <TextField fx:id="isbnField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            </GridPane>

            <Button text="Registrar Libro" onAction="#onRegistrarLibro"/>

            <Label text="Duplicar libro existente (Prototype)" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

            <HBox spacing="10">
                <Label text="Codigo origen:"/>
                <TextField fx:id="codigoOrigenField"/>
                <Label text="Nuevo codigo:"/>
                <TextField fx:id="nuevoCodigoField"/>
                <Label text="Nuevo titulo:"/>
                <TextField fx:id="nuevoTituloField"/>
                <Button text="Duplicar" onAction="#onDuplicarLibro"/>
            </HBox>

            <Label text="Libros registrados" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

            <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="100"/>
                    <TableColumn fx:id="colTitulo" text="Titulo" prefWidth="200"/>
                    <TableColumn fx:id="colAutor" text="Autor" prefWidth="150"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <Tab text="Prestamos">
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Realizar prestamo" style="-fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="8">
                <Label text="Codigo libro:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="codigoLibroPrestamoField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="ID usuario:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="idUsuarioField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Nombre usuario:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nombreUsuarioField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Dias plazo:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="diasPlazoField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            </GridPane>

            <Button text="Realizar Prestamo" onAction="#onRealizarPrestamo"/>

            <Label text="Registrar devolucion" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

            <HBox spacing="10">
                <Label text="ID prestamo:"/>
                <TextField fx:id="idPrestamoDevolucionField"/>
                <Button text="Registrar Devolucion" onAction="#onRealizarDevolucion"/>
            </HBox>

            <Label text="Prestamos registrados" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

            <TableView fx:id="tablaPrestamos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPrestamoId" text="ID" prefWidth="220"/>
                    <TableColumn fx:id="colPrestamoLibro" text="Libro" prefWidth="180"/>
                    <TableColumn fx:id="colPrestamoUsuario" text="Usuario" prefWidth="150"/>
                    <TableColumn fx:id="colPrestamoEstado" text="Estado" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

</TabPane>